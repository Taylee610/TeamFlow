SECRET_KEY=supersecret
DEBUG=True
# Set to False to use SQLite.
USE_POSTGRESQL=True
DB_NAME=teamtaskdb
DB_USER=mylocaluser
DB_PASSWORD=localuser
DB_HOST=127.0.0.1
DB_PORT=5432
ALLOWED_HOSTS=localhost,127.0.0.1
REDIS_URL=redis://127.0.0.1:6379/0
# Use True in production and configure SMTP so verification/recovery can arrive.
REQUIRE_VERIFIED_EMAIL=False
TRIAL_DAYS=14
# --- Paynow Zimbabwe: EcoCash and hosted card checkout ---
# Configure enabled methods in your Paynow merchant account; use test mode first.
# PAYNOW_INTEGRATION_ID=
# PAYNOW_INTEGRATION_KEY=
# PAYNOW_RESULT_URL=https://api.example.com/api/tools/billing/paynow/result/
# SMTP account credentials stay in .env; never commit the email password.
# Production requires DEBUG=False and a random SECRET_KEY of at least 32 characters.
# SECURE_SSL_REDIRECT=True
# CSRF_TRUSTED_ORIGINS=https://app.example.com
# --- React frontend (Vite) ---
# Optional: override the API URL the React app calls. Defaults to
# http://127.0.0.1:8000/api if not set.
VITE_API_URL=http://127.0.0.1:8000/api

# --- Email ---
# Defaults to printing emails to the console. Set these to send real mail
# via SMTP (Gmail, SendGrid SMTP, etc.) -- no code changes needed.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-address@gmail.com
# EMAIL_HOST_PASSWORD=your-google-app-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=TeamFlow <your-address@gmail.com>
# FRONTEND_URL=http://localhost:5173

# --- Taylee AI ---
# Local ML works offline without an API key.
TAYLEE_ENGINE=local_ml
# Optional cloud planning: set TAYLEE_ENGINE=anthropic and provide a key.
# ANTHROPIC_API_KEY=your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-5
