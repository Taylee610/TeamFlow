SECRET_KEY=supersecret
DEBUG=True
USE_POSTGRESQL=True         # Set to False to use SQLite
DB_NAME=teamtaskdb
DB_USER=mylocaluser
DB_PASSWORD=localuser
DB_HOST=127.0.0.1
DB_PORT=5432
# --- React frontend (Vite) ---
# Optional: override the API URL the React app calls. Defaults to
# http://127.0.0.1:8000/api if not set.
VITE_API_URL=http://127.0.0.1:8000/api

# --- Email ---
# Defaults to printing emails to the console. Set these to send real mail
# via SMTP (Gmail, SendGrid SMTP, etc.) -- no code changes needed.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=TeamFlow <noreply@teamflow.local>
# FRONTEND_URL=http://localhost:5173

# --- AI features (Anthropic) ---
# Leave unset to disable AI features (endpoints return a graceful 503).
# ANTHROPIC_API_KEY=your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-5
